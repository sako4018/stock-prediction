# .gitignore за Stock Prediction проект

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints

# Data files
data/*.csv
data/*.json
data/market/
data/news/
!data/.gitkeep

# Model files (големи файлове)
models/*.keras
models/*.h5
models/*.pkl
!models/.gitkeep
# Скалерите (*_scaler.joblib) НЕ се игнорират — без тях .pt файловете не
# могат да се заредят (load_model() изисква записан скалер, виж model.py)

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env
.env.local
.env.*.local

# Visualizations
*.png
*.jpg
*.jpeg
!static/images/.gitkeep

# Temporary files
tmp/
temp/
graphify-out/
node_modules/
frontend/node_modules/
frontend/nul
