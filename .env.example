# Копирай този файл на .env и попълни само това, което реално ползваш.
# .env е в .gitignore — никога не комитвай истински ключове.
#
# Текущата имплементация НЕ изисква нито един от тези ключове, за да
# работи: market данните идват от yfinance (^GSPC/^IXIC/^VIX/^DJI/^TNX),
# новините — от безплатния Google News RSS. И двете работят без ключ.
# Полетата по-долу са за бъдещ платен provider, ако free tier-ът
# някога стане недостатъчен (виж src/news_data.py за provider abstraction).

# Незадължителен — платен news provider (NewsAPI/Alpha Vantage/Finnhub и др.)
NEWS_API_KEY=

# Незадължителен — платен market data provider, ако yfinance спре да е надежден
MARKET_DATA_API_KEY=

# --- Централна конфигурация (src/config.py) — всички имат разумни defaults ---
# DEFAULT_TICKER=AAPL
# DEFAULT_PERIOD=2y
# PREDICTION_HORIZON_DAYS=1
# SEQUENCE_LENGTH=60
# TRAIN_SIZE=0.8
# WALKFORWARD_TRAIN_WINDOW=252
# WALKFORWARD_TEST_WINDOW=63
# WALKFORWARD_STEP_SIZE=21
# NEWS_WINDOW_HOURS=24
# NEWS_PROVIDER=google_rss
# DEFAULT_FEATURE_GROUPS=price,technical
